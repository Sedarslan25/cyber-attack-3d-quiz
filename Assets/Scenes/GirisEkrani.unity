  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "OYUN HAKKINDA\n\u0130zole bir siber laboratuvarday\u0131z. Buradaki ana
    bilgisayarlar ve sistemler b\xFCy\xFCk bir siber sald\u0131r\u0131 alt\u0131nda!\n\nBir
    yaz\u0131l\u0131m ve siber g\xFCvenlik uzman\u0131 olarak g\xF6revin, laboratuvardaki
    kilitli odalara s\u0131rayla girerek \u015Fifrelenmi\u015F sistemleri \xE7\xF6zmek,
    a\u011F a\xE7\u0131klar\u0131n\u0131 kapatmak ve siber tehdidi tamamen durdurarak
    sistemi yeniden g\xFCvenli hale getirmektir.\n\nHer odada seni bekleyen farkl\u0131
    sorular olacak. Ba\u015Far\u0131lar!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
